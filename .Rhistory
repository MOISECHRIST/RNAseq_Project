triangle <- function(a, b){
if(a<=0 || b<=0){stop("values impossible")}
else{
c <- sqrt(a^2+b^2)
s <- list(a=a,b=b, c=c)
class(s) <- "triangle"
return(s)
}
}
triangle(10,20)
